<?xml version="1.0" encoding="UTF-8"?><?import javafx.geometry.Insets?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.campusconnect.controller.StudentDashboardController">
 <left><VBox prefWidth="220" spacing="10" styleClass="sidebar"><Label text="CAMPUSCONNECT" styleClass="side-brand"/><Button text="Dashboard" styleClass="nav-active"/><Button text="Complaints" onAction="#complaints"/><Button text="Lost &amp; Found" onAction="#lostFound"/><Button text="Campus Events" onAction="#events"/><Region VBox.vgrow="ALWAYS"/><Button fx:id="logoutButton" text="Logout" onAction="#logout"/></VBox></left>
 <center><VBox spacing="20" padding="30"><Label fx:id="welcomeLabel" text="Welcome" styleClass="page-title"/><Label text="Student Dashboard" styleClass="section-title"/><HBox spacing="18"><VBox styleClass="stat-card" HBox.hgrow="ALWAYS"><Label text="PROFILE"/><Label fx:id="profileLabel" wrapText="true" styleClass="card-value"/></VBox><VBox styleClass="stat-card" HBox.hgrow="ALWAYS"><Label text="SERVICES"/><Label text="Complaints • Lost &amp; Found • Events" wrapText="true" styleClass="card-value"/></VBox></HBox><Label text="Quick access" styleClass="section-title"/><HBox spacing="15"><Button text="Report Complaint" onAction="#complaints" styleClass="primary-button"/><Button text="Find Lost Item" onAction="#lostFound"/><Button text="Explore Events" onAction="#events"/></HBox></VBox></center>
</BorderPane>
