<?xml version="1.0" encoding="UTF-8"?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.campusconnect.controller.AdminDashboardController">
 <left><VBox prefWidth="220" spacing="10" styleClass="sidebar"><Label text="CAMPUSCONNECT" styleClass="side-brand"/><Button text="Dashboard" styleClass="nav-active"/><Button text="Students" onAction="#students"/><Button text="Complaints" onAction="#complaints"/><Button text="Lost &amp; Found" onAction="#lostFound"/><Button text="Events" onAction="#events"/><Region VBox.vgrow="ALWAYS"/><Button fx:id="navButton" text="Logout" onAction="#logout"/></VBox></left>
 <center><VBox spacing="20" padding="30"><Label text="Admin Dashboard" styleClass="page-title"/><Label text="Campus overview and live operational statistics" styleClass="subtitle"/><GridPane hgap="16" vgap="16"><VBox GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="stat-card"><Label text="TOTAL STUDENTS"/><Label fx:id="students" text="—" styleClass="big-number"/></VBox><VBox GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="stat-card"><Label text="PENDING COMPLAINTS"/><Label fx:id="pending" text="—" styleClass="big-number"/></VBox><VBox GridPane.columnIndex="2" GridPane.rowIndex="0" styleClass="stat-card"><Label text="RESOLVED COMPLAINTS"/><Label fx:id="resolved" text="—" styleClass="big-number"/></VBox><VBox GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="stat-card"><Label text="LOST ITEMS"/><Label fx:id="lost" text="—" styleClass="big-number"/></VBox><VBox GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="stat-card"><Label text="FOUND ITEMS"/><Label fx:id="found" text="—" styleClass="big-number"/></VBox><VBox GridPane.columnIndex="2" GridPane.rowIndex="1" styleClass="stat-card"><Label text="EVENTS"/><Label fx:id="events" text="—" styleClass="big-number"/></VBox></GridPane><VBox styleClass="wide-card"><Label text="EVENT REGISTRATIONS"/><Label fx:id="registrations" text="—" styleClass="big-number"/></VBox></VBox></center>
</BorderPane>
